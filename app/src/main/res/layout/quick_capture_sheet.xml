<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/paper2"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What are we saving?"
        android:textColor="@color/ink"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/captureNote"
            style="@style/CaptureOption"
            android:text="Note" />

        <TextView
            android:id="@+id/captureLink"
            style="@style/CaptureOption"
            android:text="Link" />

        <TextView
            android:id="@+id/captureImage"
            style="@style/CaptureOption"
            android:text="Image" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/capturePin"
            style="@style/CaptureOption"
            android:text="Pin" />

        <TextView
            android:id="@+id/captureTask"
            style="@style/CaptureOption"
            android:text="Task" />

        <TextView
            android:id="@+id/captureClipboard"
            style="@style/CaptureOption"
            android:text="Clipboard" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save to"
        android:textColor="@color/ink_dim"
        android:textSize="12sp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/quickCaptureFolderSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/quickCaptureNewFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ New collection"
        android:textColor="@color/gold"
        android:textSize="13sp"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
